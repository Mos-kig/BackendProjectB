@page
@model AppRazor.Pages.VDFAPQModel
@{
    ViewData["Title"] = "VDFAPQ";
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]


<div class="container px-4 py-4" id="VDFAPQ">
    @* <p>
        View the details of a Friend, including Address, Pets and Quotes
    </p> *@

    <form class="needs-validation" novalidate>
        <h2 class="pb-2 border-bottom">
            View the details of a Friend, including Address, Pets and Quotes
            @* <!-- Without Validation -->
            <a href="~/Studies/FormEdit/InputModelSimple?id=@Model.Quote?.QuoteId">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em">
                    <use xlink:href="#edit" />
                </svg>
            </a>

            <!-- With ServerValidation -->
            <a href="~/Studies/FormValidation/ServerSideSimple?id=@Model.Quote?.QuoteId">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em">
                    <use xlink:href="#edit" />
                </svg>
            </a>

            <!-- With Client and Server Validation -->
            <a href="~/Studies/FormValidation/ClientSideSimple?id=@Model.Quote?.QuoteId">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em">
                    <use xlink:href="#edit" />
                </svg>
            </a> *@

        </h2>

        @if (Model.ErrorMessage != null)
        {
            <div class="row mb-1 text-center">
                <span class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </span>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
                <div class="col-md-12 col-lg-12">

                    <!-- Friend Details -->
                    <h4>Friend Details</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label for="firstName" class="form-label">First Name</label>
                            <input type="text" class="form-control" id="firstName" value="@Model.Friend.FirstName" readonly>
                        </div>
                        <div class="col-sm-6">
                            <label for="lastName" class="form-label">Last Name</label>
                            <input type="text" class="form-control" id="lastName" value="@Model.Friend.LastName" readonly>
                        </div>
                        <div class="col-sm-6">
                            <label for="email" class="form-label">Email</label>
                            <input type="text" class="form-control" id="email" value="@Model.Friend.Email" readonly>
                        </div>
                        <div class="col-sm-6">
                            <label for="friendId" class="form-label">Friend ID</label>
                            <input type="text" class="form-control" id="friendId" value="@Model.Friend.FriendId" readonly>
                        </div>
                        @if (Model.Friend.Birthday != null)
                        {
                            <div class="col-sm-6">
                                <label for="birthday" class="form-label">Birthday</label>
                                <input type="text" class="form-control" id="birthday"
                                    value="@Model.Friend.Birthday?.ToString("yyyy-MM-dd")" readonly>
                            </div>
                        }
                    </div>

                    <!-- Address Details -->
                    @if (Model.Friend.Address != null)
                    {
                        <h4>Address</h4>
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label for="streetAddress" class="form-label">Street Address</label>
                                <input type="text" class="form-control" id="streetAddress"
                                    value="@Model.Friend.Address.StreetAddress" readonly>
                            </div>
                            <div class="col-sm-3">
                                <label for="zipCode" class="form-label">Zip Code</label>
                                <input type="text" class="form-control" id="zipCode" value="@Model.Friend.Address.ZipCode"
                                    readonly>
                            </div>
                            <div class="col-sm-3">
                                <label for="city" class="form-label">City</label>
                                <input type="text" class="form-control" id="city" value="@Model.Friend.Address.City" readonly>
                            </div>
                            <div class="col-sm-6">
                                <label for="country" class="form-label">Country</label>
                                <input type="text" class="form-control" id="country" value="@Model.Friend.Address.Country"
                                    readonly>
                            </div>
                        </div>
                    }

                    <!-- Pets Details -->
                    @if (Model.Friend.Pets != null && Model.Friend.Pets.Any())
                    {
                        <h4>Pets</h4>
                        <div class="row g-3 mb-4">
                            @foreach (var pet in Model.Friend.Pets)
                            {
                                <div class="col-sm-4">
                                    <div class="card">
                                        <div class="card-body">
                                            <h6 class="card-title">@pet.Name</h6>
                                            <p class="card-text">
                                                <strong>Kind:</strong> @pet.Kind<br>
                                                <strong>Mood:</strong> @pet.Mood
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Quotes Details -->
                    @if (Model.Friend.Quotes != null && Model.Friend.Quotes.Any())
                    {
                        <h4>Favorite Quotes</h4>
                        <div class="row g-3 mb-4">
                            @foreach (var quote in Model.Friend.Quotes)
                            {
                                <div class="col-sm-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <blockquote class="blockquote mb-0">
                                                <p>"@quote.QuoteText"</p>
                                                <footer class="blockquote-footer">@quote.Author</footer>
                                            </blockquote>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>
        }
    </form>
</div>

@section Scripts
{
    <!-- -->
    <partial name="_ValidationScriptsPartial" />
}