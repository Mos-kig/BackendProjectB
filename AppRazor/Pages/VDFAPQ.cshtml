@page
@model AppRazor.Pages.VDFAPQModel
@{
    ViewData["Title"] = "VDFAPQ";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<div class="container px-4 py-4" id="VDFAPQ">
    <form class="needs-validation @(Model.ValidationResult.HasErrors ? "was-validated" : "")" method="post" novalidate>
        <input type="hidden" name="id" data-seido-selected-item-id-target />

        <p>
            1.View the details of a Friend, including Address, Pets and Quotes.<br>
            2.Edit the details of a Friend with frontend and server-side validation.<br>
            3.Edit the details of a Friends Address with frontend and server-side validation.<br>
            4.Delete a Pet and a Quote from a Friend with modal confirmation.
        </p>

        <input type="hidden" name="friendId" data-seido-selected-item-id-target />
        <input type="hidden" name="currentFriendId"
            value="@(Model.Friend?.FriendId ?? (Model.friendIM?.FirstOrDefault()?.FriendId ?? Guid.Empty)) " />

        @if (Model.ValidationResult.HasErrors)
        {
            <div class="row g-3">
                @foreach (var item in Model.ValidationResult.ErrorMsgs)
                {
                    <span class="alert alert-danger" role="alert">
                        @item
                    </span>
                }
            </div>
        }
        @if (Model.ErrorMessage != null)
        {
            <div class="row mb-1 text-center">
                <span class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </span>
            </div>
        }

        <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
            <div class="col-md-7 col-lg-10">

                <!-- Friend Details -->
                <h4>Friend Details</h4>

                @for (int k = 0; k < Model.friendIM.Count; k++)
                {
                    <div
                        class="row mb-2 text-center @(Model.friendIM[k].StatusIM == AppRazor.Pages.VDFAPQModel.StatusIM.Deleted ? "d-none" : null)">

                        <!-- Hidden fields so they are preserved by the Modelbinder -->
                        <input asp-for="friendIM[k].StatusIM" value="@Model.friendIM[k].StatusIM" class="form-control"
                            type="hidden" />
                        <input asp-for="friendIM[k].FriendId" value="@Model.friendIM[k].FriendId" class="form-control"
                            type="hidden" />
                        <input asp-for="friendIM[k].FirstName" value="@Model.friendIM[k].FirstName" class="form-control"
                            type="hidden" />
                        <input asp-for="friendIM[k].LastName" value="@Model.friendIM[k].LastName" class="form-control"
                            type="hidden" />
                        <input asp-for="friendIM[k].Email" value="@Model.friendIM[k].Email" class="form-control"
                            type="hidden" />
                        <input asp-for="friendIM[k].Birthday" value="@Model.friendIM[k].Birthday" class="form-control"
                            type="hidden" />
                        <div class="col-md-10 themed-grid-col">
                            <div class="row g-2">
                                <div class="col-6"><strong>Name:</strong> @Model.friendIM[k].FirstName
                                    @Model.friendIM[k].LastName</div>
                                <div class="col-6"><strong>Email:</strong> @Model.friendIM[k].Email</div>
                                <div class="col-6"><strong>ID:</strong> @Model.friendIM[k].FriendId</div>
                                @if (Model.friendIM[k].Birthday != null)
                                {
                                    <div class="col-6"><strong>Birthday:</strong>
                                        @Model.friendIM[k].Birthday?.ToString("yyyy-MM-dd")</div>
                                }
                            </div>
                        </div>
                        <div class="col-md-2 themed-grid-col">
                            <button class="btn btn-secondary btn-sm m-1" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseEdit_@Model.friendIM[k].FriendId">
                                Edit
                            </button>

                            <!-- Button trigger post Delete -->
                            <button type="submit" asp-page-handler="Delete" asp-route-friendId="@Model.friendIM[k].FriendId"
                                class="btn btn-danger btn-sm m-1">
                                Del
                            </button>
                            <button class="btn btn-outline-secondary" type="submit" asp-page-handler="Undo">
                                ↶ Undo
                            </button>
                        </div>
                    </div>

                    <div class="collapse row mb-2 text-center" id="collapseEdit_@Model.friendIM[k].FriendId">
                        <div class="form-floating col-md-6 themed-grid-col">
                            <!--Fields to edit -->
                            <input asp-for="friendIM[k].EditFirstName" class="form-control"
                                value="@Model.friendIM[k].EditFirstName" />
                            <span asp-validation-for="friendIM[k].EditFirstName" class="invalid-feedback"></span>
                            <label asp-for="friendIM[k].EditFirstName">FirstName</label>
                        </div>
                        <div class="form-floating col-md-6 themed-grid-col">
                            <!--Fields to edit -->
                            <input asp-for="friendIM[k].EditLastName" class="form-control"
                                value="@Model.friendIM[k].EditLastName" />
                            <span asp-validation-for="friendIM[k].EditLastName" class="invalid-feedback"></span>
                            <label asp-for="friendIM[k].EditLastName">LastName</label>
                        </div>
                        <div class="form-floating col-md-6 themed-grid-col">
                            <!--Edit Email -->
                            <input asp-for="friendIM[k].EditEmail" class="form-control" type="email"
                                value="@Model.friendIM[k].EditEmail" />
                            <span asp-validation-for="friendIM[k].EditEmail" class="invalid-feedback"></span>
                            <label asp-for="friendIM[k].EditEmail">Email</label>
                        </div>
                        <div class="form-floating col-md-6 themed-grid-col">
                            <!--Edit Birthday -->
                            <input asp-for="friendIM[k].EditBirthday" class="form-control" type="date"
                                value="@(Model.friendIM[k].EditBirthday?.ToString("yyyy-MM-dd") ?? "")" />
                            <span asp-validation-for="friendIM[k].EditBirthday" class="invalid-feedback"></span>
                            <label asp-for="friendIM[k].EditBirthday">Birthday</label>
                        </div>
                        <div class="form-floating col-md-12 themed-grid-col">
                            <button type="submit" asp-page-handler="Edit" asp-route-friendId="@Model.friendIM[k].FriendId"
                                class="btn btn-success btn-sm m-1">
                                💾 Save Details.
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.AddressIMs.Any())
        {
            <h4>Address</h4>
            @for (int i = 0; i < Model.AddressIMs.Count; i++)
            {
                <div class="row mb-2 text-center">
                    <!-- Hidden fields for Address -->
                    <input asp-for="AddressIMs[i].StatusIM" value="@Model.AddressIMs[i].StatusIM" class="form-control"
                        type="hidden" />
                    <input asp-for="AddressIMs[i].AddressId" value="@Model.AddressIMs[i].AddressId" class="form-control"
                        type="hidden" />
                    <input asp-for="AddressIMs[i].StreetAddress" value="@Model.AddressIMs[i].StreetAddress" class="form-control"
                        type="hidden" />
                    <input asp-for="AddressIMs[i].ZipCode" value="@Model.AddressIMs[i].ZipCode" class="form-control"
                        type="hidden" />
                    <input asp-for="AddressIMs[i].City" value="@Model.AddressIMs[i].City" class="form-control" type="hidden" />
                    <input asp-for="AddressIMs[i].Country" value="@Model.AddressIMs[i].Country" class="form-control"
                        type="hidden" />

                    <div class="col-md-10 themed-grid-col">
                        <div class="row g-2">
                            <div class="col-12">
                                <strong>Address:</strong> @Model.AddressIMs[i].StreetAddress, @Model.AddressIMs[i].ZipCode
                                @Model.AddressIMs[i].City, @Model.AddressIMs[i].Country
                            </div>
                            <div class="col-12">
                                <strong>AddressID:</strong> @Model.AddressIMs[i].AddressId
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 themed-grid-col">
                        <button class="btn btn-secondary btn-sm m-1" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapseEditAddress_@Model.AddressIMs[i].AddressId">
                            Edit
                        </button>
                        <button class="btn btn-outline-secondary" type="submit" asp-page-handler="Undo">
                            ↶ Undo
                        </button>
                    </div>
                </div>

                <!-- Edit Address Collapsible Form -->
                <div class="collapse row mb-2 text-center" id="collapseEditAddress_@Model.AddressIMs[i].AddressId">
                    <div class="form-floating col-md-6 themed-grid-col">
                        <input asp-for="AddressIMs[i].EditStreetAddress" class="form-control"
                            value="@Model.AddressIMs[i].EditStreetAddress" />
                        <span asp-validation-for="AddressIMs[i].EditStreetAddress" class="invalid-feedback"></span>
                        <label asp-for="AddressIMs[i].EditStreetAddress">Street Address</label>
                    </div>
                    <div class="form-floating col-md-6 themed-grid-col">
                        <input asp-for="AddressIMs[i].EditZipCode" class="form-control"
                            value="@Model.AddressIMs[i].EditZipCode" />
                        <span asp-validation-for="AddressIMs[i].EditZipCode" class="invalid-feedback"></span>
                        <label asp-for="AddressIMs[i].EditZipCode">Zip Code</label>
                    </div>
                    <div class="form-floating col-md-6 themed-grid-col">
                        <input asp-for="AddressIMs[i].EditCity" class="form-control" value="@Model.AddressIMs[i].EditCity" />
                        <span asp-validation-for="AddressIMs[i].EditCity" class="invalid-feedback"></span>
                        <label asp-for="AddressIMs[i].EditCity">City</label>
                    </div>
                    <div class="form-floating col-md-6 themed-grid-col">
                        <input asp-for="AddressIMs[i].EditCountry" class="form-control"
                            value="@Model.AddressIMs[i].EditCountry" />
                        <span asp-validation-for="AddressIMs[i].EditCountry" class="invalid-feedback"></span>
                        <label asp-for="AddressIMs[i].EditCountry">Country</label>
                    </div>
                    <div class="form-floating col-md-12 themed-grid-col">
                        <button type="submit" asp-page-handler="EditAddress" asp-route-friendId="@Model.friendIM[0].FriendId"
                            class="btn btn-success btn-sm m-1">
                            💾 Save Address
                        </button>
                    </div>
                </div>
            }
        }

        <!-- Pets Details -->
        @if (Model.Friend?.Pets != null && Model.Friend.Pets.Any())
        {
            <h4>Pets</h4>
            <div class="row g-3 mb-4">
                @foreach (var pet in Model.Friend.Pets)
                {
                    <div class="col-sm-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">@pet.Name</h6>
                                <p class="card-text">
                                    <strong>Kind:</strong> @pet.Kind<br>
                                    <strong>Mood:</strong> @pet.Mood<br>
                                    <strong>PetID:</strong> @pet.PetId
                                </p>
                            </div>
                            <button type="button" class="btn btn-danger btn-sm m-1" data-bs-toggle="modal"
                                data-bs-target="#deletePetModal" data-pet-id="@pet.PetId">Del</button>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Quotes Details -->
        @if (Model.Friend?.Quotes != null && Model.Friend.Quotes.Any())
        {
            <h4>Favorite Quotes</h4>
            <div class="row g-3 mb-4">
                @foreach (var quote in Model.Friend.Quotes)
                {
                    <div class="col-sm-12">
                        <div class="card">
                            <div class="card-body">
                                <blockquote class="blockquote mb-0">
                                    <p>"@quote.QuoteText"</p>
                                    <footer class="blockquote-footer">@quote.Author</footer>
                                </blockquote>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </form>
    <div class="modal fade" id="deletePetModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="DeletePet">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger">Delete Pet?</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete this pet?
                    </div>
                    <div class="modal-footer">
                        <input type="hidden" name="currentFriendId" value="@(Model.Friend?.FriendId ?? Guid.Empty)" />
                        <input type="hidden" name="itemId" id="deletePet_ItemId_Input" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete Pet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        const deletePetModal = document.getElementById('deletePetModal');
        if (deletePetModal) {
            deletePetModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const petId = button.getAttribute('data-pet-id');
                const petIdInput = deletePetModal.querySelector('#deletePet_ItemId_Input');
                petIdInput.value = petId;
            });
        }
    </script>
}