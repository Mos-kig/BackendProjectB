@page
@model AppRazor.Pages.FPCSCModel
@{
    ViewData["Title"] = "FPCSC";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<div class="container px-4 py-4" id="FPCSC">
    <h2 class="pb-2 border-bottom">Overview Friends and Pets in the cities of a specific country.</h2>
    <div class="row mb-1 text-center">
        <div class="col-md-8 ">
            <form class="d-flex mt-3 mt-lg-0" role="search" method="get">
                <input asp-for="SearchFilter" class="form-control me-2" type="search"
                    placeholder="Search Country or City" aria-label="Search">
                <button asp-page-handler="Search" class="btn btn-outline-success" type="submit">Search</button>
            </form>
        </div>
    </div>
    @foreach (var cityGroup in Model.CityInfo)
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4 py-5">
            <div class="col d-flex align-items-start">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em">
                    <use xlink:href="#Sweden" />
                </svg>
                <div>
                    <h3 class="fw-bold mb-0 fs-4 text-body-emphasis">@(cityGroup.Key)</h3>
                    <p>@cityGroup.Count() Friends</p>
                    <p>@(Model.PetInfo?.FirstOrDefault(g => g.Key == cityGroup.Key)?.Count() ?? 0) Pets</p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts
{
    <!-- -->
    <partial name="_ValidationScriptsPartial" />
}