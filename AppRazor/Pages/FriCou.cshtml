@page
@model AppRazor.Pages.FriCouModel
@{
    ViewData["Title"] = "FriCou";
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<div class="container px-4 py-4" id="FriCou">
    <h2 class="pb-2 border-bottom">Overview Friends by country.</h2>

    @foreach (var countryGroup in Model.CountryInfo)
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4 py-2">
            <div class="col d-flex align-items-start">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em">
                    <use xlink:href="#Sweden" />
                </svg>
                <div>
                    <h3 class="fw-bold mb-0 fs-4 text-body-emphasis">@(countryGroup.Key)</h3>
                    <p>@countryGroup.Count() friends</p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts
{
    <!-- -->
    <partial name="_ValidationScriptsPartial" />
}